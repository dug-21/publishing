{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extracted structure of the standard",
  "type": "object",
  "required": ["schema_version", "document", "sections", "terms", "requirements", "prose"],
  "properties": {
    "document": {
      "type": "object",
      "required": ["title", "version", "lang"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$" },
        "lang": { "type": "string", "pattern": "^[a-z]{2}(-[A-Za-z]+)?$" }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "level", "kind"],
        "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "scope" } } } },
        { "contains": { "properties": { "id": { "const": "normative-references" } } } },
        { "contains": { "properties": { "id": { "const": "terms" } } } },
        { "contains": { "properties": { "id": { "const": "bibliography" } } } },
        { "contains": { "properties": { "kind": { "const": "appendix" } } } }
      ]
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "term", "definition"],
        "properties": {
          "id": { "type": "string", "pattern": "^term-[a-z0-9-]+$" },
          "term": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "number", "title", "clause", "group", "statement", "testing_procedures", "guidance"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "number": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "clause": { "type": "object", "required": ["id", "number", "title"] },
          "group": { "type": "object", "required": ["id", "number", "title"] },
          "statement": { "type": "string", "minLength": 1 },
          "guidance": { "type": "string", "minLength": 1 },
          "testing_procedures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label", "text"],
              "properties": {
                "id": { "type": "string", "pattern": "^TP-[0-9]+\\.[0-9]+\\.[0-9]+\\.[a-z]$" },
                "label": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[a-z]$" },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
